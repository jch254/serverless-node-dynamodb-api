{
  "name": "serverless-node-dynamodb-api",
  "version": "2.0.0",
  "description": "Serverless, Node and DynamoDB-powered API",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.ts",
  "scripts": {
    "dev": "cross-env NODE_ENV=development serverless offline start",
    "docker-dev": "cross-env NODE_ENV=development serverless offline start --host 0.0.0.0",
    "dynamodb:install": "serverless dynamodb install",
    "lint": "eslint 'src/**/*.ts' || exit 0",
    "typecheck": "tsc --noEmit",
    "create-domain": "cross-env NODE_ENV=production SLS_DEBUG=true serverless create_domain --stage prod",
    "deploy": "cross-env NODE_ENV=production SLS_DEBUG=true serverless deploy --stage prod",
    "delete-domain": "cross-env NODE_ENV=production SLS_DEBUG=true serverless delete_domain --stage prod",
    "package": "cross-env NODE_ENV=production SLS_DEBUG=true serverless package --stage prod"
  },
  "author": "Jordan Hornblow <jordan@jch254.com>",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1045.0",
    "@aws-sdk/lib-dynamodb": "^3.1045.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.161",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.18",
    "@types/webpack": "^5.28.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.6.0",
    "serverless": "^4.35.1",
    "serverless-domain-manager": "^10.1.0",
    "serverless-dynamodb": "^0.2.58",
    "serverless-dynamodb-autoscaling": "^0.6.2",
    "serverless-offline": "^14.5.0",
    "serverless-webpack": "^5.15.4",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  }
}
